        "content": [
          {
            "cache_control": {
              "type": "ephemeral"
            },
            "text": "# Environment\nWorking directory: /workspace/tasky\nIs a git repository: yes\nPlatform: linux\nShell: bash\nToday's date: 2026-01-15\nModel: synth-coder-8b\n\n# Repository snapshot\nBranch: main\nLast commit: a1b2c3d Add due dates to tasks\nUncommitted changes: none",
            "type": "text"
          }
        ],
        "role": "system"
